# Voice Agent backend configuration
# Copy to .env and adjust

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# CORS (JSON list)
CORS_ORIGINS=["http://localhost:3000"]

# LLM (required for the agent; get a free key at https://console.groq.com)
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Whisper STT
WHISPER_MODEL=base            # tiny, base, small, medium
WHISPER_DEVICE=cpu            # cpu, cuda
WHISPER_COMPUTE_TYPE=int8     # int8, float16, float32

# TTS (Kokoro)
TTS_VOICE=af_heart
TTS_LANG=en-us

# Model downloads cache (Silero VAD, Kokoro)
MODEL_CACHE_DIR=model-cache

# Turn detection tuning
VAD_THRESHOLD_START=0.5
VAD_THRESHOLD_END=0.35
VAD_SILENCE_MS=600
